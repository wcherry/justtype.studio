# Backend
JUSTTYPE_BIND_ADDR=127.0.0.1:8088
JUSTTYPE_DATABASE_URL=./data/justtype.db
JUSTTYPE_DATA_DIR=./data/works
JUSTTYPE_JWT_SECRET=change-me-to-a-long-random-string
JUSTTYPE_ACCESS_TTL_MINUTES=30
JUSTTYPE_REFRESH_TTL_DAYS=30
JUSTTYPE_CORS_ORIGINS=http://localhost:5183
# Links in mail point here. Mail goes to data/outbox.jsonl unless
# JUSTTYPE_MAIL=smtp and the JUSTTYPE_SMTP_* settings are given, or
# JUSTTYPE_MAIL=resend and the Resend key below.
JUSTTYPE_PUBLIC_URL=http://localhost:5183
JUSTTYPE_MAIL=outbox
# JUSTTYPE_RESEND_API_KEY=re_...
# JUSTTYPE_MAIL_FROM=Just Type <hello@justtype.studio>
# Summaries and the writing assistant are off unless this is set; see docs/API.md.
# ANTHROPIC_API_KEY=
# Which model the writing assistant uses (summaries: JUSTTYPE_SUMMARY_MODEL).
# JUSTTYPE_ASSISTANT_MODEL=claude-opus-5-5
# Sign-up guard; see docs/API.md. Limits are per rolling hour or day, 0 turns
# one off. Behind a reverse proxy or Cloudflare, set JUSTTYPE_TRUST_PROXY=true,
# or every sign-up counts against the proxy's address.
# JUSTTYPE_TRUST_PROXY=false
# JUSTTYPE_SIGNUP_IP_HOURLY=3
# JUSTTYPE_SIGNUP_IP_DAILY=10
# JUSTTYPE_SIGNUP_GLOBAL_HOURLY=60
# Cloudflare Turnstile on the sign-up form: set both keys or neither. While it
# is on, sign-ups that did not pass it get the tighter limits below.
# JUSTTYPE_TURNSTILE_SITE_KEY=
# JUSTTYPE_TURNSTILE_SECRET_KEY=
# JUSTTYPE_SIGNUP_UNVERIFIED_IP_DAILY=2
# JUSTTYPE_SIGNUP_UNVERIFIED_GLOBAL_HOURLY=10
RUST_LOG=justtype_backend=debug,tower_http=debug,info
