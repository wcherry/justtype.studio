# Backend
JUSTTYPE_BIND_ADDR=127.0.0.1:8088
JUSTTYPE_DATABASE_URL=./data/justtype.db
JUSTTYPE_DATA_DIR=./data/works
JUSTTYPE_JWT_SECRET=change-me-to-a-long-random-string
JUSTTYPE_ACCESS_TTL_MINUTES=30
JUSTTYPE_REFRESH_TTL_DAYS=30
JUSTTYPE_CORS_ORIGINS=http://localhost:5183
# Links in mail point here. Mail goes to data/outbox.jsonl unless
# JUSTTYPE_MAIL=smtp and the JUSTTYPE_SMTP_* settings are given.
JUSTTYPE_PUBLIC_URL=http://localhost:5183
JUSTTYPE_MAIL=outbox
# Summaries are off unless this is set; see docs/API.md, "Summaries".
# ANTHROPIC_API_KEY=
RUST_LOG=justtype_backend=debug,tower_http=debug,info
